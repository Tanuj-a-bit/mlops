{
    "dashboard": {
        "title": "Recommendation System Monitoring",
        "tags": [
            "mlops",
            "recommendations",
            "monitoring"
        ],
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "System Performance Metrics",
                "type": "row",
                "gridPos": {
                    "h": 1,
                    "w": 24,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Request Rate (RPS)",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 8,
                    "x": 0,
                    "y": 1
                },
                "targets": [
                    {
                        "expr": "rate(rec_request_count_total[5m])",
                        "legendFormat": "Requests/sec"
                    }
                ]
            },
            {
                "id": 3,
                "title": "Latency (p95/p99)",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 8,
                    "x": 8,
                    "y": 1
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(rec_latency_seconds_bucket[5m]))",
                        "legendFormat": "p95"
                    },
                    {
                        "expr": "histogram_quantile(0.99, rate(rec_latency_seconds_bucket[5m]))",
                        "legendFormat": "p99"
                    }
                ]
            },
            {
                "id": 4,
                "title": "Error & Timeout Rate",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 8,
                    "x": 16,
                    "y": 1
                },
                "targets": [
                    {
                        "expr": "rate(rec_error_count_total[5m])",
                        "legendFormat": "Errors/sec"
                    },
                    {
                        "expr": "rate(rec_timeout_count_total[5m])",
                        "legendFormat": "Timeouts/sec"
                    }
                ]
            },
            {
                "id": 5,
                "title": "Business Metrics",
                "type": "row",
                "gridPos": {
                    "h": 1,
                    "w": 24,
                    "x": 0,
                    "y": 9
                }
            },
            {
                "id": 6,
                "title": "Click-Through Rate (CTR)",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 0,
                    "y": 10
                },
                "targets": [
                    {
                        "expr": "rec_ctr"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "percentunit",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 0.05,
                                    "color": "yellow"
                                },
                                {
                                    "value": 0.1,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 7,
                "title": "Conversion Rate",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 6,
                    "y": 10
                },
                "targets": [
                    {
                        "expr": "rec_conversion_rate"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "percentunit",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 0.02,
                                    "color": "yellow"
                                },
                                {
                                    "value": 0.05,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 8,
                "title": "Add-to-Cart Rate",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 12,
                    "y": 10
                },
                "targets": [
                    {
                        "expr": "rec_add_to_cart_rate"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "percentunit"
                    }
                }
            },
            {
                "id": 9,
                "title": "Bounce Rate",
                "type": "stat",
                "gridPos": {
                    "h": 6,
                    "w": 6,
                    "x": 18,
                    "y": 10
                },
                "targets": [
                    {
                        "expr": "rec_bounce_rate"
                    }
                ],
                "fieldConfig": {
                    "defaults": {
                        "unit": "percentunit",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "green"
                                },
                                {
                                    "value": 0.5,
                                    "color": "yellow"
                                },
                                {
                                    "value": 0.7,
                                    "color": "red"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 10,
                "title": "User Engagement",
                "type": "row",
                "gridPos": {
                    "h": 1,
                    "w": 24,
                    "x": 0,
                    "y": 16
                }
            },
            {
                "id": 11,
                "title": "Dwell Time Distribution",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 17
                },
                "targets": [
                    {
                        "expr": "rec_dwell_time_seconds",
                        "legendFormat": "Dwell Time"
                    }
                ]
            },
            {
                "id": 12,
                "title": "User Actions Over Time",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 17
                },
                "targets": [
                    {
                        "expr": "rate(rec_clicks_total[5m])",
                        "legendFormat": "Clicks/sec"
                    },
                    {
                        "expr": "rate(rec_impressions_total[5m])",
                        "legendFormat": "Impressions/sec"
                    },
                    {
                        "expr": "rate(rec_conversions_total[5m])",
                        "legendFormat": "Conversions/sec"
                    },
                    {
                        "expr": "rate(rec_add_to_carts_total[5m])",
                        "legendFormat": "Add-to-Carts/sec"
                    }
                ]
            },
            {
                "id": 13,
                "title": "Model Quality Metrics",
                "type": "row",
                "gridPos": {
                    "h": 1,
                    "w": 24,
                    "x": 0,
                    "y": 25
                }
            },
            {
                "id": 14,
                "title": "Precision@10",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 4,
                    "x": 0,
                    "y": 26
                },
                "description": "Precision at K=10"
            },
            {
                "id": 15,
                "title": "Recall@10",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 4,
                    "x": 4,
                    "y": 26
                },
                "description": "Recall at K=10"
            },
            {
                "id": 16,
                "title": "F1@10",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 4,
                    "x": 8,
                    "y": 26
                },
                "description": "F1 Score at K=10"
            },
            {
                "id": 17,
                "title": "NDCG@10",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 4,
                    "x": 12,
                    "y": 26
                },
                "description": "Normalized Discounted Cumulative Gain at K=10"
            },
            {
                "id": 18,
                "title": "MAP",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 4,
                    "x": 16,
                    "y": 26
                },
                "description": "Mean Average Precision"
            },
            {
                "id": 19,
                "title": "MRR",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 4,
                    "x": 20,
                    "y": 26
                },
                "description": "Mean Reciprocal Rank"
            }
        ],
        "refresh": "30s",
        "schemaVersion": 27,
        "version": 1
    }
}