generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int        @id
  parentId  Int?
  name      String
  slug      String     @unique
  image     String
  createdAt DateTime   @default(now())
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id          Int      @id
  categoryId  Int
  name        String
  description String
  price       Float
  image       String
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  inStock     Boolean  @default(true)
  properties  String
  createdAt   DateTime @default(now())
  events      Event[]
  category    Category @relation(fields: [categoryId], references: [id])
  reviews     Review[]

  @@index([categoryId])
}

model User {
  id            Int            @id @default(autoincrement())
  email         String?        @unique
  name          String?
  password      String?
  role          String         @default("USER")
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  events        Event[]
  reviews       Review[]
  sellerProfile SellerProfile?
}

model SellerProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  storeName   String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Event {
  id            Int     @id @default(autoincrement())
  timestamp     BigInt
  visitorId     Int
  eventType     String
  itemId        Int
  transactionId String?
  product       Product @relation(fields: [itemId], references: [id])
  user          User    @relation(fields: [visitorId], references: [id])

  @@index([visitorId])
  @@index([itemId])
  @@index([eventType])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId])
}
